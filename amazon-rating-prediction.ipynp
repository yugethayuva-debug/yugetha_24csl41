            "   actual_price  discounted_price  rating\n",
            "0        1099.0             399.0     4.2\n",
            "1         349.0             199.0     4.0\n",
            "2        1899.0             199.0     3.9\n",
            "3         699.0             329.0     4.2\n",
            "4         399.0             154.0     4.2\n",
